{
  "$schema": "https://raw.githubusercontent.com/leeforge/schema/main/schema.json",
  "name": "User",
  "description": "System Users",
  "softDelete": true,
  "info": {
    "collectionName": "users",
    "displayName": "User Management",
    "description": "Manage system users and their profiles",
    "icon": "User",
    "locale": "en-US"
  },
  "ui": {
    "submitText": "Save",
    "resetText": "Reset",
    "showReset": true,
    "layout": {
      "direction": "vertical",
      "gap": 16,
      "columns": 2
    }
  },
  "features": {
    "softDelete": true,
    "export": true,
    "import": true,
    "batch": true
  },
  "properties": {
    "id": {
      "type": "uid",
      "label": "ID",
      "description": "Unique Identifier",
      "private": true,
      "writable": false,
      "ui": {
        "showInList": true,
        "showInForm": false
      }
    },
    "username": {
      "type": "string",
      "label": "Username",
      "description": "Login username",
      "validate": {
        "required": true,
        "minLength": 3,
        "maxLength": 50
      },
      "unique": true,
      "ui": {
        "widget": "text",
        "placeholder": "Enter username",
        "span": 12,
        "showInList": true,
        "showInForm": true,
        "sortable": true,
        "filterable": true
      },
      "queryable": true,
      "exportable": true
    },
    "email": {
      "type": "string",
      "label": "Email",
      "description": "Email address",
      "validate": {
        "required": true,
        "format": "email"
      },
      "unique": true,
      "ui": {
        "widget": "text",
        "placeholder": "Enter email",
        "span": 12,
        "showInList": true,
        "showInForm": true,
        "filterable": true
      },
      "queryable": true,
      "exportable": true
    },
    "password_hash": {
      "type": "string",
      "label": "Password",
      "description": "User password",
      "private": true,
      "validate": {
        "required": true
      },
      "ui": {
        "widget": "password",
        "span": 12,
        "showInList": false,
        "showInForm": true
      }
    },
    "nickname": {
      "type": "string",
      "label": "Nickname",
      "default": "System User",
      "ui": {
        "widget": "text",
        "span": 12,
        "showInList": true,
        "showInForm": true
      },
      "queryable": true,
      "exportable": true
    },
    "phone": {
      "type": "string",
      "label": "Phone",
      "ui": {
        "widget": "text",
        "span": 12,
        "showInList": true,
        "showInForm": true
      },
      "queryable": true,
      "exportable": true
    },
    "avatar": {
      "type": "string",
      "label": "Avatar",
      "ui": {
        "widget": "image",
        "span": 24,
        "showInList": true,
        "showInForm": true
      },
      "exportable": true
    },
    "status": {
      "type": "enum",
      "label": "Status",
      "default": "active",
      "validate": {
        "enum": ["active", "inactive", "suspended"]
      },
      "ui": {
        "widget": "select",
        "span": 12,
        "showInList": true,
        "showInForm": true,
        "filterable": true,
        "options": [
          { "value": "active", "label": "Active" },
          { "value": "inactive", "label": "Inactive" },
          { "value": "suspended", "label": "Suspended" }
        ]
      },
      "queryable": true,
      "exportable": true
    },
    "roles": {
      "$ref": "Role",
      "label": "Roles",
      "$relation": {
        "type": "many2Many",
        "labelField": "name"
      },
      "ui": {
        "widget": "select",
        "multiple": true,
        "span": 24,
        "showInList": false,
        "showInForm": true
      }
    },
    "createdAt": {
      "type": "datetime",
      "label": "Created At",
      "writable": false,
      "ui": {
        "widget": "datetime",
        "showInList": true,
        "showInForm": false,
        "sortable": true
      },
      "exportable": true
    },
    "updatedAt": {
      "type": "datetime",
      "label": "Updated At",
      "writable": false,
      "ui": {
        "widget": "datetime",
        "showInList": true,
        "showInForm": false
      },
      "exportable": true
    }
  }
}
